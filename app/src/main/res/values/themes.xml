<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Material3.TextView" parent="@android:style/Widget.Material.TextView">
        <item name="android:fontFamily">@font/google_sans_flex_subset</item>
    </style>

    <style name="Typography.App.MainTitle" parent="Widget.Material3.TextView">
        <item name="android:fontFamily">@font/google_sans_flex_subset</item>
        <item name="android:fontVariationSettings">&quot;ROND&quot; 100</item>
        <item name="android:textSize">32sp</item>
    </style>

    <style name="Typography.App.DetailPaneTitle" parent="Widget.Material3.TextView">
        <item name="android:fontFamily">@font/google_sans_flex_subset</item>
        <item name="android:fontVariationSettings">&quot;ROND&quot; 100</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Typography.App.ItemTitle" parent="Widget.Material3.TextView">
        <item name="android:fontFamily">@font/google_sans_flex_subset</item>
        <item name="android:fontVariationSettings">&quot;ROND&quot; 100</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Typography.App.ItemDescription" parent="Widget.Material3.TextView">
        <item name="android:fontFamily">@font/google_sans_flex_subset</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Theme.RetroControl" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/google_sans_flex_subset</item>
    </style>
    <style name="Theme.RetroControl.TileDialog" parent="android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:fontFamily">@font/google_sans_flex_subset</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
